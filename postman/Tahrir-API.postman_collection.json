    {
      "name": "Grammar",
      "description": "Matn bilan ishlash.\n\nTekshiruv — odam matn yozadi, backend xatolarni topadi (noto'g'ri so'z, bo'shliq, tinish belgilari) va \"shu yerni shunday tuzat\" deb qaytaradi.\nQayta yozish — matnni soddaroq, rasmiyroq yoki qisqaroq qiladi.\nTahlil — grammatika, ravshanlik, ohang qanday, shuni aytadi.",
      "item": [
        {
          "name": "Check text",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Matnni tekshirish. Editor dagi qizil chiziqlar shu javobdan chiziladi. Login shart emas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Bizning kompaniya butun dunyo mijozlariga professional xizmat korsatadi.\"\n}"
            },
            "url": "{{baseUrl}}/grammar/check"
          }
        },
