{
  "info": {
    "name": "Tahrir Backend",
    "description": "Tahrir sayti backend.\n\nQanday ishlaydi: frontend so'rov yuboradi, backend bazadan tekshiradi va javob qaytaradi.\n\nBase URL (oldida /api yo'q):\nhttps://tahrir-backend-production-524d.up.railway.app\n\nAvval Auth → Login (admin) ni yuboring. Token o'zi saqlanadi.\n\nDemo:\nadmin@tahrir.uz / Admin1234!\nuser@tahrir.uz / User1234!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://tahrir-backend-production-524d.up.railway.app"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "description": "Server ishlayaptimi, shuni tekshiradi. Hech narsa saqlamaydi. Sayt ochilishidan oldin shu yerni bosib ko'ring.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "description": "Backend tirikmi. Javob kelsa, server ishlayapti.",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Public stats",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "description": "Bosh sahifadagi umumiy raqamlar.",
            "url": "{{baseUrl}}/stats"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Foydalanuvchini tanish.\n\nLogin — odam email va parol yozadi, backend bazadan tekshiradi. To'g'ri bo'lsa ruxsat (token) beradi.\nRegister — yangi odamni bazaga yozadi.\nMe — hozir kim kirdi, shuni aytadi.\nParolni unutdim — yangi parol qo'yish yo'li.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Yangi hisob ochadi. Ism, email, parol yoziladi. Email band bo'lsa, ochilmaydi. Ochilsa token beriladi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Yangi Foydalanuvchi\",\n  \"email\": \"yangi@tahrir.uz\",\n  \"password\": \"User1234!\",\n  \"confirmPassword\": \"User1234!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token;",
                  "if (token) pm.environment.set('token', token);",
                  "const user = json?.data?.user;",
                  "if (user?.id) pm.environment.set('userId', user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Foydalanuvchini tekshirish. Email va parol kiritiladi. To'g'ri bo'lsa token beriladi. Shu so'rovni birinchi yuboring — token avtomatik saqlanadi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tahrir.uz\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token;",
                  "if (token) pm.environment.set('token', token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Oddiy foydalanuvchi sifatida kirish. Ham email va parol kiritiladi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@tahrir.uz\",\n  \"password\": \"User1234!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "description": "Hozir kim kirdi. Token bo'lsa, ism, email, rolini qaytaradi.",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Parolni unutgan odam email yozadi. Backend tiklash yo'lini beradi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@tahrir.uz\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Yangi parol qo'yadi. Token va yangi parol kerak.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN\",\n  \"password\": \"User1234!\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Foydalanuvchilar.\n\nOddiy odam faqat o'z ismini yoki parolini o'zgartiradi.\nAdmin hamma userlarni ko'radi, yangi odam qo'shadi, rolini o'zgartiradi yoki o'chiradi.",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "description": "O'z profilini olish.",
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "O'z ismini yoki parolini yangilash.",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Demo User Updated\"\n}" },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "List users (admin)",
          "request": {
            "method": "GET",
            "description": "Barcha foydalanuvchilar. Faqat admin.",
            "url": "{{baseUrl}}/users?page=1&limit=10&search="
          }
        },
        {
          "name": "Create user (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Admin yangi odam qo'shadi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Manager\",\n  \"email\": \"manager@tahrir.uz\",\n  \"password\": \"Manager123!\",\n  \"role\": \"manager\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "description": "Bitta foydalanuvchini ko'rish. Admin.",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update user (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Rolini yoki faolligini o'zgartirish.",
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true,\n  \"role\": \"user\"\n}" },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Delete user (admin)",
          "request": {
            "method": "DELETE",
            "description": "Foydalanuvchini o'chirish. Admin.",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Plans",
      "description": "Saytdagi tariflar: Free, Plus, Pro, Team.\n\nFrontend \"qanday tariflar bor?\" deb so'raydi, backend narx, imkoniyatlar va tugma matnini qaytaradi. Pricing sahifasi shu yerdan to'ladi.",
      "item": [
        {
          "name": "List plans",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = Array.isArray(json.data) ? json.data[0] : null;",
                  "if (first?.id) pm.environment.set('planId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "description": "Barcha tariflar ro'yxati. Login shart emas.",
            "url": "{{baseUrl}}/plans"
          }
        },
        {
          "name": "Get plan",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "description": "Bitta tarifni ko'rish.",
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        },
        {
          "name": "Create plan (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Yangi tarif qo'shish. Admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student\",\n  \"description\": \"Talabalar uchun\",\n  \"monthlyPrice\": 5,\n  \"features\": [\"50 ta hujjat / oy\"]\n}"
            },
            "url": "{{baseUrl}}/plans"
          }
        },
        {
          "name": "Update plan (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Tarifni o'zgartirish. Admin.",
            "body": { "mode": "raw", "raw": "{\n  \"isPopular\": true\n}" },
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        },
        {
          "name": "Delete plan (admin)",
          "request": {
            "method": "DELETE",
            "description": "Tarifni o'chirish. Admin.",
            "url": "{{baseUrl}}/plans/{{planId}}"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "description": "Obuna. Foydalanuvchi tarif tanlaydi, backend \"shu odam endi Plus/Pro da\" deb yozib qo'yadi. Bekor qilsa, obuna to'xtaydi. Buning uchun avval login kerak.",
      "item": [
        {
          "name": "Subscribe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.environment.set('subscriptionId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Tarifni tanlash. planId va oylik/yillik yoziladi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"billingPeriod\": \"monthly\"\n}"
            },
            "url": "{{baseUrl}}/subscriptions"
          }
        },
        {
          "name": "My subscriptions",
          "request": {
            "method": "GET",
            "description": "Mening obunalarim.",
            "url": "{{baseUrl}}/subscriptions/me"
          }
        },
        {
          "name": "Cancel subscription",
          "request": {
            "method": "PATCH",
            "description": "Obunani bekor qilish.",
            "url": "{{baseUrl}}/subscriptions/{{subscriptionId}}/cancel"
          }
        }
      ]
    },
